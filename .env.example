# Copy this file to .env and fill in real values. .env is gitignored — never
# commit your real .env.

# Port the server listens on (optional)
PORT=3000

# Admin login for /admin.html — pick your own username and a strong password.
# These are only ever checked server-side; the browser never stores them.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Signs the admin login session cookie. Pick a long random string and keep it
# stable — if you change it, everyone gets logged out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# The published CSV URL of your Google Form's response sheet.
# In Google Sheets: File > Share > Publish to web > select the responses
# sheet > format "Comma-separated values (.csv)" > Publish, then copy the link.
# Optional — you can also paste this directly into the admin page instead.
SHEET_CSV_URL=

# Set this to "production" when deploying (e.g. on Render) so the session
# cookie requires HTTPS. Leave unset for local development over http://.
NODE_ENV=
