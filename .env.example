# Copy this file to .env and fill in real values. .env is gitignored.

# Port the server listens on (optional)
PORT=3000

# Secret key you choose yourself — required to use /admin.html and the
# /api/admin/* endpoints. Pick any long random string.
ADMIN_KEY=change-me-to-something-long-and-random

# The published CSV URL of your Google Form's response sheet.
# In Google Sheets: File > Share > Publish to web > select the responses
# sheet > format "Comma-separated values (.csv)" > Publish, then copy the link.
# Optional — you can also paste this directly into the admin page instead.
SHEET_CSV_URL=
